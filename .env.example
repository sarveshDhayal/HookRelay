# HookRelay Environment Configuration

# Application
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Database (MySQL 8)
# If using standard Docker Compose: mysql://hookrelay:hookrelay_secret@localhost:3306/hookrelay_db
# If using local mysqld on port 3307: mysql://hookrelay:hookrelay_secret@127.0.0.1:3307/hookrelay_db
# Or via socket: mysql://hookrelay:hookrelay_secret@localhost/hookrelay_db?socket=/tmp/hookrelay_mysql.sock
DATABASE_URL="mysql://hookrelay:hookrelay_secret@localhost/hookrelay_db?socket=/tmp/hookrelay_mysql.sock"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_32_bytes
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_development_32_bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Worker Configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
DELIVERY_TIMEOUT_MS=10000
CIRCUIT_BREAKER_THRESHOLD=5

# Mock Receiver
MOCK_RECEIVER_PORT=4001

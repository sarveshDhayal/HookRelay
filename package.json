{
  "name": "hookrelay",
  "version": "1.0.0",
  "description": "Webhook delivery platform with retries, rate limiting, and monitoring dashboard",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "demo": "node scripts/demo.js",
    "benchmark": "node scripts/load-test.js"
  },
  "keywords": [
    "webhook",
    "delivery",
    "retry",
    "token-bucket",
    "min-heap",
    "circuit-breaker"
  ],
  "author": "3rd-year CS & AI Student",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "prisma": "^5.22.0"
  }
}

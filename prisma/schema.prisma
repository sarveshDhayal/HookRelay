datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  role         String            @default("DEVELOPER") // "ADMIN" or "DEVELOPER"
  plan         String            @default("FREE")      // "FREE" (60 req/min) or "PRO" (300 req/min)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  apiKeys      ApiKey[]
  endpoints    WebhookEndpoint[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  rateLimit  Int       @default(60) // tokens per minute capacity
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id                  String     @id @default(uuid())
  userId              String
  url                 String     @db.VarChar(512)
  description         String?
  secret              String     // HMAC SHA-256 signing secret
  eventTypes          Json       // Stored as JSON array: ["*"] or ["payment.success"]
  isActive            Boolean    @default(true)
  isPaused            Boolean    @default(false) // Set by circuit breaker on 5 consecutive failures
  consecutiveFailures Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

model Event {
  id             String     @id @default(uuid())
  userId         String?
  type           String     // e.g. "payment.succeeded"
  payload        Json
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  deliveries     Delivery[]

  @@map("events")
}

model Delivery {
  id            String            @id @default(uuid())
  eventId       String
  endpointId    String
  status        String            @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DEAD
  retryCount    Int               @default(0)
  maxAttempts   Int               @default(6)
  nextAttemptAt DateTime          @default(now())
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint      WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts      DeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([endpointId])
  @@map("deliveries")
}

model DeliveryAttempt {
  id            String    @id @default(uuid())
  deliveryId    String
  attemptNumber Int
  statusCode    Int?
  responseBody  String?   @db.Text
  error         String?   @db.Text
  latencyMs     Int
  attemptedAt   DateTime  @default(now())

  delivery      Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_attempts")
}

